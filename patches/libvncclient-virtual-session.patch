+static uint16_t tm_u16(const unsigned char *p) { return ((uint16_t)p[0] << 8) | p[1]; }
+static uint32_t tm_u32(const unsigned char *p) { return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3]; }
+static rfbBool tm_read_session_body(rfbClient *client, unsigned char *body, size_t capacity, size_t *length)
+{
+  unsigned char header[2];
+  if (!ReadFromRFBServer(client, (char *)header, 2)) return FALSE;
+  *length = tm_u16(header);
+  if (*length < 6 || *length > capacity) return FALSE;
+  return ReadFromRFBServer(client, (char *)body, *length);
+}
+static rfbBool tm_select_virtual_session(rfbClient *client)
+{
+  const unsigned char *name = (const unsigned char *)client->desktopName;
+  unsigned char body[4096], command[74] = {0};
+  size_t length, userLength;
+  uint32_t flags;
+  if (client->si.nameLength < 22 || name[0] != 0) return FALSE;
+  flags = tm_u32(name + 2);
+  tm_flags = flags;
+  if (!(flags & 4) || (flags & 8)) return FALSE;
+  if (!tm_read_session_body(client, body, sizeof(body), &length) || length < 10 || tm_u16(body) != 1) return FALSE;
+  tm_allowed = tm_u32(body + 2);
+  if (!(tm_allowed & (1U << 2))) return FALSE;
+  userLength = length - 10;
+  if (userLength > 64) return FALSE;
+  /* Body size 72, version 1, command 2 (virtual desktop), console username. */
+  command[1] = 72; command[3] = 1; command[8] = 2;
+  if (userLength) memcpy(command + 10, body + 10, userLength);
+  command[73] = 0;
+  if (!WriteToRFBServer(client, (char *)command, sizeof(command))) return FALSE;
+  for (unsigned int pending = 0; pending < 32; pending++) {
+    uint32_t status;
+    if (!tm_read_session_body(client, body, sizeof(body), &length) || tm_u16(body) != 1) return FALSE;
+    status = tm_u32(body + 2);
+    tm_status = status;
+    if (status == 0 || status == 4) {
+      rfbClientSetClientData(client, &terminalMacSessionTag, &terminalMacSessionTag);
+      return TRUE;
+    }
+    if (status != 2 && status != 3) return FALSE;
+  }
+  return FALSE;
+}
+/* Apple keeps a subscription separate from ordinary RFB update requests.
+ * Renew it after a full refresh and idle/lock tickles, always at real dimensions. */
+static rfbBool tm_auto_update(rfbClient *client, int x, int y, int width, int height)
+{
+  unsigned char message[16] = {9, 0, 0, 1, 0, 0, 0, 0};
+  if (width <= 0 || height <= 0 || width > 8192 || height > 8192 || x < 0 || y < 0) return FALSE;
+  message[8] = x >> 8; message[9] = x;
+  message[10] = y >> 8; message[11] = y;
+  message[12] = width >> 8; message[13] = width;
+  message[14] = height >> 8; message[15] = height;
+  return WriteToRFBServer(client, (char *)message, sizeof(message));
+}
+/* Ask for an ordinary lossless virtual display; never synchronize clipboard. */
+static rfbBool tm_session_setup(rfbClient *client)
+{
+  unsigned char info[66] = {0};
+  const unsigned char mode[4] = {10, 0, 0, 1};
+  const unsigned char display[8] = {13, 1, 0, 0, 0, 0, 0, 0};
+  const unsigned char clipboard[8] = {21, 0, 0, 0, 0, 0, 0, 0};
+  info[0] = 33; info[3] = 62; info[5] = 1; info[9] = 2;
+  info[13] = 6; info[17] = 1; info[25] = 15;
+  /* Advertise only the commands we actually send: framebuffer requests,
+     key/pointer input, mode, display and viewer information. */
+  info[34] = 0xb0; info[36] = 0x0c; info[37] = 0x03;
+  info[38] = 0x90; info[44] = 0x40;
+  return WriteToRFBServer(client, (char *)info, sizeof(info)) &&
+         WriteToRFBServer(client, (char *)mode, sizeof(mode)) &&
+         WriteToRFBServer(client, (char *)display, sizeof(display)) &&
+         WriteToRFBServer(client, (char *)clipboard, sizeof(clipboard));
+}
