+  unsigned int message;
+  uint64_t until = tm_monotonic_microseconds() + 10000;
+  for (message = 0; message < 32; message++) {
+    int ready = WaitForMessage(client, 0);
+    if (ready < 0 || (ready > 0 && !HandleRFBServerMessage(client))) return FALSE;
+    if (!ready || tm_monotonic_microseconds() >= until) break;
+  }
+  return TRUE;
+}
+static rfbBool tm_wheel_ticks(rfbClient *client, int x, int y, int amount, int vertical)
