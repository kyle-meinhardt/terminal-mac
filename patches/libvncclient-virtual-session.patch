+      rfbClientSetClientData(client, &terminalMacWheelPointSizeTag, (void *)(uintptr_t)((pointWidth << 16) | pointHeight));
+      rfbClientSetClientData(client, &terminalMacWheelPixelSizeTag, (void *)(uintptr_t)((pixelWidth << 16) | pixelHeight));
+    }
+  }
+  width = rectangleWidth > 0 ? rectangleWidth : tm_u16(payload + 6);
+  height = rectangleHeight > 0 ? rectangleHeight : tm_u16(payload + 8);
+  if (!width || !height || width > 8192 || height > 8192 || (uint64_t)width * height > 16777216) goto done;
+  if ((client->width != (int)width || client->height != (int)height) &&
+      !ResizeClientBuffer(client, width, height)) goto done;
+  ok = SendFramebufferUpdateRequest(client, 0, 0, width, height, FALSE);
+done:
+  free(payload);
+  return ok;
+}
