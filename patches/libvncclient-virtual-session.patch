+/* Apple DisplayInfo2 has a u16 length followed by a 20-byte header and
+ * 56-byte display entries. Coordinates here are framebuffer pixels, not points. */
+static rfbBool tm_display_info2(rfbClient *client, int rectangleWidth, int rectangleHeight)
+{
+  unsigned char lengthBytes[2], *payload;
+  size_t length;
+  unsigned int width, height, count;
+  rfbBool ok = FALSE;
+  if (!ReadFromRFBServer(client, (char *)lengthBytes, 2)) return FALSE;
+  length = tm_u16(lengthBytes);
+  if (length < 20) return FALSE;
+  payload = malloc(length);
+  if (!payload) return FALSE;
+  if (!ReadFromRFBServer(client, (char *)payload, length)) goto done;
+  count = tm_u16(payload + 18);
+  if (count > 64 || length < 20 + count * 56) goto done;
+  {
+    uint32_t pointWidth = tm_u16(payload + 2), pointHeight = tm_u16(payload + 4);
+    uint32_t pixelWidth = tm_u16(payload + 6), pixelHeight = tm_u16(payload + 8);
+    const char *diagnostics = getenv("TERMINAL_MAC_VNC_DIAGNOSTICS");
+    if (diagnostics && strcmp(diagnostics, "1") == 0) fprintf(stderr, "terminal-mac display points=%u,%u pixels=%u,%u rectangle=%d,%d\n", pointWidth, pointHeight, pixelWidth, pixelHeight, rectangleWidth, rectangleHeight);
