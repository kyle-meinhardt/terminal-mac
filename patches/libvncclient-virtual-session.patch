+static rfbBool tm_store_auth_key(rfbClient *client, const unsigned char *key)
+{
+  unsigned char *copy = malloc(16);
+  if (!copy) return FALSE;
+  memcpy(copy, key, 16);
+  rfbClientSetClientData(client, &terminalMacKeyTag, copy);
+  return TRUE;
