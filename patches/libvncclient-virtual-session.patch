+/* terminal-mac virtual-session extension, 2026-11-06.
+ * Wire facts checked against noVNC-ARD's documented Session Select exchange.
+ * This library is deliberately restricted to Apple's separately selected user
+ * desktop. A plain RFB server or a console-only grant fails closed.
+ */
+static char terminalMacSessionTag, terminalMacMessageTag, terminalMacEncodingTag, terminalMacKeyTag, terminalMacCoverageTag, terminalMacClockOriginTag, terminalMacPointerMaskTag, terminalMacWheelPointSizeTag, terminalMacWheelPixelSizeTag;
+struct tm_coverage {
+  unsigned char *bits;
+  size_t count, total;
+  int width, height, complete;
+};
+static void tm_reset_coverage(rfbClient *client)
+{
+  struct tm_coverage *coverage = rfbClientGetClientData(client, &terminalMacCoverageTag);
+  if (coverage) { free(coverage->bits); free(coverage); }
+  rfbClientSetClientData(client, &terminalMacCoverageTag, NULL);
+}
+/* Return 1 only once every framebuffer pixel has actually been decoded since
+ * allocation/resize. Apple may send a notification tile well before the rest
+ * of the desktop, so a timer cannot establish first-frame completeness. */
+static int tm_mark_frame(rfbClient *client, int x, int y, int width, int height)
+{
+  struct tm_coverage *coverage = rfbClientGetClientData(client, &terminalMacCoverageTag);
+  int row;
+  if (!coverage) {
+    size_t total;
+    if (client->width <= 0 || client->height <= 0 || client->width > 8192 || client->height > 8192) return -1;
+    total = (size_t)client->width * client->height;
+    if (total > 16777216) return -1;
+    coverage = calloc(1, sizeof(*coverage));
+    if (!coverage) return -1;
+    coverage->bits = calloc((total + 7) / 8, 1);
+    if (!coverage->bits) { free(coverage); return -1; }
+    coverage->width = client->width; coverage->height = client->height; coverage->total = total;
+    rfbClientSetClientData(client, &terminalMacCoverageTag, coverage);
+  }
+  if (coverage->complete) return 1;
+  if (x < 0 || y < 0 || width < 0 || height < 0 || x > coverage->width - width || y > coverage->height - height) return -1;
+  for (row = y; row < y + height; row++) {
+    size_t start = (size_t)row * coverage->width + x, left = width;
+    while (left) {
+      unsigned int offset = start & 7, take = 8 - offset;
+      unsigned char mask, old;
+      if (take > left) take = left;
+      mask = (unsigned char)(((1U << take) - 1) << offset);
+      old = coverage->bits[start >> 3];
+      coverage->count += __builtin_popcount((unsigned int)(mask & ~old));
+      coverage->bits[start >> 3] = old | mask;
+      start += take; left -= take;
+    }
+  }
+  {
+    const char *diagnostics = getenv("TERMINAL_MAC_VNC_DIAGNOSTICS");
+    if (diagnostics && strcmp(diagnostics, "1") == 0)
+      fprintf(stderr, "terminal-mac coverage=%zu/%zu rect=%d,%d,%d,%d encoding=%u\n", coverage->count, coverage->total, x, y, width, height,
+              (uint32_t)((uintptr_t)rfbClientGetClientData(client, &terminalMacEncodingTag) - 1));
+  }
+  if (coverage->count == coverage->total) {
+    coverage->complete = 1;
+    free(coverage->bits); coverage->bits = NULL;
+  }
+  return coverage->complete;
+}
+int terminal_mac_session_api_version(void) { return 2; }
+static uint64_t tm_monotonic_microseconds(void)
+{
+  struct timespec now;
+  if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) return 0;
+  return (uint64_t)now.tv_sec * 1000000 + now.tv_nsec / 1000;
+}
