+/* Apple GestureEvent pair: compact floating-point lines, then detailed wheel.
+ * CLI deltas follow CGEvent: negative Y scrolls down; ARD wire points use the opposite sign.
+ */
+static void tm_put16(unsigned char *p, uint16_t value) { p[0] = value >> 8; p[1] = value; }
+static void tm_put32(unsigned char *p, uint32_t value) { p[0] = value >> 24; p[1] = value >> 16; p[2] = value >> 8; p[3] = value; }
+static int32_t tm_round(double value) { return (int32_t)(value < 0 ? value - 0.5 : value + 0.5); }
+rfbBool terminal_mac_scroll(rfbClient *client, int x, int y, int dx, int dy)
+{
+  unsigned char compact[36] = {23, 0, 0, 32, 0, 2, 0, 8};
+  unsigned char detailed[58] = {23, 0, 0, 54, 0, 1, 0, 11};
+  float lineX = -(float)dx / 45.0f, lineY = -(float)dy / 45.0f;
+  uint32_t bits;
+  int lineStepX = dx == 0 ? 0 : (lineX > 0 ? (tm_round(lineX) > 0 ? tm_round(lineX) : 1) : (tm_round(lineX) < 0 ? tm_round(lineX) : -1));
+  int lineStepY = dy == 0 ? 0 : (lineY > 0 ? (tm_round(lineY) > 0 ? tm_round(lineY) : 1) : (tm_round(lineY) < 0 ? tm_round(lineY) : -1));
+  if (!terminal_mac_virtual_session(client) || x < 0 || y < 0 || x >= client->width || y >= client->height || dx < -1000 || dx > 1000 || dy < -1000 || dy > 1000) return FALSE;
+  memcpy(&bits, &lineX, 4); tm_put32(compact + 8, bits);
+  memcpy(&bits, &lineY, 4); tm_put32(compact + 12, bits);
+  tm_put32(compact + 20, 1);
+  tm_put16(compact + 32, x); tm_put16(compact + 34, y);
+  tm_put16(detailed + 8, (uint16_t)lineStepX); tm_put16(detailed + 10, (uint16_t)lineStepY);
+  tm_put32(detailed + 14, (uint32_t)tm_round((double)lineX * 65536));
+  tm_put32(detailed + 18, (uint32_t)tm_round((double)lineY * 65536));
+  tm_put32(detailed + 26, (uint32_t)-dx); tm_put32(detailed + 30, (uint32_t)-dy);
+  tm_put16(detailed + 54, x); tm_put16(detailed + 56, y);
+  return WriteToRFBServer(client, (char *)compact, sizeof(compact)) && WriteToRFBServer(client, (char *)detailed, sizeof(detailed));
+}
