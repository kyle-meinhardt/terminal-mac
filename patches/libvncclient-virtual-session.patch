+/* Each Apple wheel pulse advances one logical point. Keep target positions
+ * in raw framebuffer pixels, converting only the requested scroll distance
+ * through DisplayInfo2's backing ratio (one pulse per pixel if absent). */
+static int tm_wheel_count(rfbClient *client, int amount, int vertical)
+{
+  uint32_t points = (uint32_t)(uintptr_t)rfbClientGetClientData(client, &terminalMacWheelPointSizeTag);
+  uint32_t pixels = (uint32_t)(uintptr_t)rfbClientGetClientData(client, &terminalMacWheelPixelSizeTag);
+  unsigned int logical = vertical ? points & 65535 : points >> 16;
+  unsigned int physical = vertical ? pixels & 65535 : pixels >> 16;
+  unsigned int distance = abs(amount);
+  if (!logical || !physical) return distance;
+  return (distance * logical + physical - 1) / physical;
+}
+static rfbBool tm_wheel_drain(rfbClient *client)
